# Nebius Token Factory — get from https://console.nebius.com/token-factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model selection: use Lightning for dev, Ultra for official benchmark runs
# CHRONICLE_MODEL=nvidia/nemotron-mini-4b-instruct

# Tavily — get from https://tavily.com (Builders Program gives free credits)
TAVILY_API_KEY=

# Hermes plugin: set to 0 to stop masking emails/phones/IDs in recalled memory
# CHRONICLE_REDACT_RECALL=1
